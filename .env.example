#
# Copy to .env and fill in. Building the benchmark needs only the judge's
# provider; evaluating models needs a key for each provider you score.

# Required: the judge J_gen defaults to gpt-5 (OpenAI). Also covers OpenAI evaluees.
OPENAI_API_KEY=

# Required only when a source benchmark is gated on the HuggingFace Hub.
HF_TOKEN=

# The NLVR2 copy you requested from its authors (see README -> NLVR2).
# Unset: NLVR2 is skipped.
PRISM_NLVR2_DIR=

# Optional: overrides `cache_root` from the run config.
HF_CACHE_DIR=

# Per-provider evaluee keys -- also used when `judge.model` points at one.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Single-server fallback for vLLM evaluees, when configs/endpoints.yaml is absent.
PRISM_VLLM_ENDPOINT=
